{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "security": {
      "assetProtocol": {
        "enable": false,
        "scope": []
      },
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; media-src 'self' http://127.0.0.1:*; style-src 'self' 'unsafe-inline'",
      "devCsp": null
    },
    "windows": [
      {
        "backgroundColor": "#f8efe8",
        "decorations": true,
        "height": 900,
        "label": "main",
        "minHeight": 720,
        "minWidth": 1000,
        "resizable": true,
        "theme": "Light",
        "title": "al-Iyaal Kids",
        "titleBarStyle": "Visible",
        "width": 1320
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "bun run web:build",
    "beforeDevCommand": "bun run web:dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "resources": [
      "../python-worker/worker.py",
      "../python-worker/src",
      "../python-worker/requirements.lock.txt",
      "../assets/bin/yap.sh"
    ],
    "targets": ["dmg"]
  },
  "identifier": "com.rhaq.aliyaalkids",
  "productName": "al-Iyaal Kids",
  "version": "1.3.0"
}
