  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-slot": "^1.3.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "engines": {
    "bun": ">=1.3.12",
    "node": ">=25.0.0"
  },
  "name": "al-iyaal-kids",
  "packageManager": "bun@1.3.12",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ragaeeb/al-iyaal-kids.git"
  },
  "scripts": {
    "build": "bun run tauri:build",
    "check": "bun run typecheck && bun run lint && bun run test",
    "dev": "bun run tauri:dev",
    "format": "biome format --write .",
    "icons:check": "bun run icons:sync && test -f src-tauri/icons/icon.icns",
    "icons:sync": "bun ./scripts/sync-icons.ts",
    "lint": "biome check .",
    "postinstall": "bun run yap:sync",
    "preview": "vite preview",
    "release": "semantic-release",
    "sign:macos": "./scripts/sign-notarize-macos.sh",
    "tauri": "tauri",
    "tauri:build": "bun run version:sync && bun run icons:sync && bun run yap:sync && tauri build",
    "tauri:dev": "bun run version:sync && bun run icons:sync && bun run yap:sync && tauri dev",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "version:sync": "bun ./scripts/sync-version.ts",
    "web:build": "tsc --noEmit && vite build",
    "web:dev": "vite",
    "yap:sync": "./scripts/sync-yap.sh"
  },
  "type": "module",
  "version": "1.3.0"
}
